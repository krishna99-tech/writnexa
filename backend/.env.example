APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_USER=quorix
DB_PASSWORD=quorix_dev_secret
DB_NAME=quorix_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_NAME=quorix_rt
COOKIE_SECURE=false

# Email System (SES API, SES SMTP Relay, or Mock)
EMAIL_PROVIDER=mock
EMAIL_DEV_MODE=true
EMAIL_FROM=QUORIX <noreply@quorix.io>
EMAIL_REPLY_TO=support@quorix.io
EMAIL_WORKER_POLL=3s
EMAIL_WORKER_BATCH=10
EMAIL_MAX_RETRIES=3

# AWS SES API Configuration (Optional if using SMTP relay)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Amazon SES SMTP Relay Configuration (For users with SES SMTP credentials)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
