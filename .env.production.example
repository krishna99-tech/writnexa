# ==============================================================================
# QUORIX Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Generate distinct cryptographically secure secrets before deploying.
# DO NOT commit real secrets, private keys, or passwords to source control.

# Application Runtime
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_USER=quorix_admin
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_64_CHARS
DB_NAME=quorix_prod
DB_SSLMODE=prefer
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# Redis 7 Cache & Session Store
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_ENABLED=true
REDIS_DB=0

# Cryptographic Authentication & JWT Secrets (Generate using: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_HEX_32_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_HEX_32_CHAR_REFRESH_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Production CORS Whitelist (Strict origin matching)
CORS_ALLOWED_ORIGINS=https://writnexa.dev,https://www.writnexa.dev,http://localhost:3000,http://127.0.0.1:3000

# Amazon Simple Email Service (SES)
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=notifications@writnexa.dev
AWS_SES_FROM_NAME="WRITNEXA Platform"
# If using IAM Roles on EC2/ECS/EKS, credentials are automatically resolved.
# If using direct SMTP relay or static credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_SMTP_USER=
# AWS_SES_SMTP_PASSWORD=
# AWS_SES_SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com

# Media Storage (AWS S3)
S3_BUCKET_NAME=quorix-production-media-assets
S3_REGION=us-east-1

# Google AdSense (Optional monetization)
ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=https://writnexa.dev
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

