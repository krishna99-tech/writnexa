# ==============================================================================
# QUORIX Platform Environment Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env.local) for local development
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=quorix
DB_PASSWORD=quorix_dev_secret
DB_NAME=quorix_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Cache & Rate Limiter (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=development_access_token_secret_min_32_characters_long
JWT_REFRESH_SECRET=development_refresh_token_secret_min_32_characters_long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Amazon SES & Transactional Email
# In development, set EMAIL_MODE=dev to log emails or forward to Mailpit (localhost:1025)
EMAIL_MODE=dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@writnexa.dev
SES_FROM_NAME="QUORIX Team"

# Media Storage (AWS S3)
# In development, set S3_MODE=dev for local mock storage
S3_MODE=dev
S3_BUCKET=quorix-media-dev
S3_REGION=us-east-1

